{
  "name": "formly-form-viewer-material",
  "version": "1.0.0",
  "author": "Juan Jose Arroyo Rivera",
  "description": "Standalone component to render a customizable FormlyForm",
  "repository": {
    "type": "git",
    "url": "https://github.com/JJKid/formly-form-viewer-material.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng-packagr -p ng-package.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "build:verified": "npm run test:ci && npm run build",
    "lint": "ng lint",
    "pack:dry-run": "npm run build:verified && npm pack --dry-run ./dist/formly-form-viewer-material",
    "publish:dist": "npm run build:verified && npm publish ./dist/formly-form-viewer-material --access public",
    "prepublishOnly": "npm run build:verified"
  },
  "peerDependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.31",
    "@angular/core": "^20.3.31",
    "@angular/forms": "^20.3.31",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.31",
    "@ngx-formly/core": "^7.1.0",
    "@ngx-formly/material": "^7.1.0"
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "formly-form-parser": "2.0.0",
    "survey-structure": "3.0.0"
  },
  "devDependencies": {
    "zone.js": "~0.15.1",
    "@angular-devkit/build-angular": "20.3.37",
    "@angular-eslint/builder": "20.7.0",
    "@angular-eslint/eslint-plugin": "20.7.0",
    "@angular-eslint/eslint-plugin-template": "20.7.0",
    "@angular-eslint/schematics": "20.7.0",
    "@angular-eslint/template-parser": "20.7.0",
    "@angular/animations": "^20.3.31",
    "@angular/cli": "^20.3.37",
    "@angular/common": "^20.3.31",
    "@angular/compiler": "^20.3.31",
    "@angular/compiler-cli": "^20.3.31",
    "@angular/core": "^20.3.31",
    "@angular/language-service": "^20.3.31",
    "@angular/platform-browser": "^20.3.31",
    "@angular/platform-browser-dynamic": "^20.3.31",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "^8.57.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "20.3.2",
    "typescript": "5.9.3"
  },
  "homepage": "https://github.com/JJKid/formly-form-viewer-material",
  "overrides": {
    "rollup-plugin-dts": "6.4.1",
    "uuid": "11.1.1",
    "qs": "6.16.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "license": "MIT"
}
